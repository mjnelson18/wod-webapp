# Dunelmliga. A separate group of friends and a standalone league, published as a
# sub-path of the WOD site because GitHub Pages serves one site per repo.
#
#   npm run build:dunelmliga
VITE_SITE_BASE=/wod-webapp/dunelmliga/
VITE_SITE_BRAND=Dunelmliga
VITE_SITE_TAGLINE=· data pack
VITE_SITE_TITLE=Dunelmliga
VITE_SITE_DESCRIPTION=Dunelmliga — data pack for a draft Fantasy Premier League.
