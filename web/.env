# Default site: What's On Draft. `vite build` with no --mode uses these, and so
# does `npm run dev`.
#
# A second site is a second file — .env.<slug> — plus `vite build --mode <slug>`.
# Which seasons and leagues that site covers is the pipeline's business, in
# pipeline/config/sites.py; this file only decides how it looks and where it is
# served from.
VITE_SITE_BASE=/wod-webapp/
VITE_SITE_BRAND=What's On Draft
VITE_SITE_TAGLINE=· data pack
VITE_SITE_TITLE=What's On Draft
VITE_SITE_DESCRIPTION=What's On Draft — data packs for a draft Fantasy Premier League.

# The trigger worker's /ask endpoint (natural-language Explorer queries).
# Not a secret — the worker holds the API key. Confirm the workers.dev
# subdomain after the first deploy with workers_dev=true; leave this unset
# (or delete the line) to hide the Ask box entirely.
VITE_ASK_ENDPOINT=https://wod-trigger.mjnelson18.workers.dev/ask
