# Generated pipeline output — regenerated every build, never in main history (CLAUDE.md)
/data/

# Cached raw API responses for finalized gameweeks
/pipeline/cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Node / Vite
node_modules/
/web/dist/

# Generated data served to the frontend. The pipeline (or, for now,
# scripts/make-dev-fixtures.mjs) writes this at build time — same rule as /data.
/web/public/data/

# Rendered PNGs from the old report (67 MB). The weekly_report_GW*.html files are
# kept as the content-inventory source; the images themselves are not needed.
/reference/old_html/*.png

# Machine-local Claude Code settings (launch.json IS shared; this one isn't).
# Also covered by the global gitignore here, but keep it with the repo so the
# protection travels to other machines.
.claude/settings.local.json

# OS
Thumbs.db
.DS_Store
